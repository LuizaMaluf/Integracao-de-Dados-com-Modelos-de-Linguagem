# ──────────────────────────────────────────────────────────────────
# Configuração única do projeto (ingestion, dbt e integration).
# Copie para .env na raiz: o docker-compose e o govhub leem daqui.
# ──────────────────────────────────────────────────────────────────

# ── Anthropic ─────────────────────────────────────────────────────
# [OBRIGATÓRIO para LLM] Decision Layer e parser PDF semântico.
# Sem a chave, a integração roda só com análise local (sem LLM).
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo da Decision Layer (integration)
MODEL_NAME=claude-sonnet-4-6
# Modelo do parser PDF semântico (ingestion)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Integration: limiares ─────────────────────────────────────────
# Match rate mínimo para um Candidate Key ser aceito
MIN_MATCH_RATE=0.5
# Confiança mínima para promover um candidato a Integration Key
MIN_CONFIDENCE=0.6
# Número máximo de Candidate Keys passados ao LLM por par de tabelas
MAX_CANDIDATE_KEYS=10
# Linhas amostradas por tabela na Evidence Layer
SAMPLE_SIZE=1000

# ── Ingestion: MinIO (Bronze Zone) ────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze

# ── Ingestion: DuckDB (Silver Zone) ───────────────────────────────
# Caminho dentro do container — mapeado por volume no docker-compose
DUCKDB_PATH=/opt/airflow/data/silver.duckdb

# ── PostgreSQL analítico (dbt + costuras) ─────────────────────────
# Dentro do docker-compose o host é "postgres"; fora dele, localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=govhub
POSTGRES_PASSWORD=govhub
POSTGRES_DB=govhub
