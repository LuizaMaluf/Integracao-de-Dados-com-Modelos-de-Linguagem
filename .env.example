# ──────────────────────────────────────────────────────────────────
# Configuração única do projeto (integração, dbt e PostgreSQL).
# Copie para .env na raiz: o docker-compose, o dbt e o govhub leem daqui.
# ──────────────────────────────────────────────────────────────────

# ── LLM ───────────────────────────────────────────────────────────
# [OBRIGATÓRIO para LLM] Decision Layer.
# Sem a chave, a integração roda só com análise local (sem LLM).
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo da Decision Layer
MODEL_NAME=claude-sonnet-4-6
# Backend do LLM (src/govhub/llm.py): anthropic (API key acima) ou claude-cli
# (Claude Code headless, `claude -p`, usando o login/assinatura da máquina).
LLM_BACKEND=anthropic

# ── Integração: limiares ──────────────────────────────────────────
# Match rate mínimo para um Candidate Key ser aceito
MIN_MATCH_RATE=0.5
# Confiança mínima para promover um candidato a Integration Key
MIN_CONFIDENCE=0.6
# Número máximo de Candidate Keys passados ao LLM por par de tabelas
MAX_CANDIDATE_KEYS=10
# Linhas amostradas por tabela na Evidence Layer
SAMPLE_SIZE=1000

# ── PostgreSQL ────────────────────────────────────────────────────
# Local (docker compose) ou o banco do GovHub de onde as bases são lidas.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=govhub
POSTGRES_PASSWORD=govhub
POSTGRES_DB=govhub
